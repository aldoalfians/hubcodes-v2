{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Main window: core commands and events only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "updater:default",
    "process:allow-restart",
    "notification:default"
  ]
}
